# Server Port
PORT=5000

# Environment (development | production)
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas cluster credentials:
# 1. Create a free cluster at https://www.mongodb.com/cloud/atlas
# 2. Add a Database User (username & password)
# 3. In Network Access, add IP Address 0.0.0.0/0 (allow access from anywhere)
# 4. Click 'Connect' -> 'Connect your application' -> Copy the connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# Client URLs allowed for CORS (comma-separated if multiple, e.g. Vercel deployment URL)
CLIENT_URL=http://localhost:5173,http://localhost:3000
